-- Desktop overlay games: see-through-pixel games that float over the desktop
-- (run via Proton/GE-Proton with WINE_LAYERED_OVERLAY_ALPHA=1 in Steam launch
-- options). Hyprland makes each one a floating, screen-filling window instead
-- of tiling/exclusive-fullscreen, so the desktop and your windows stay rendered
-- underneath through the game's transparent pixels.
--
-- Shared rules for overlay games:
--  - Never tile: tiling rescales the surface and can break the game's rendering.
--  - Fill the WHOLE MONITOR like fullscreen (size = monitor_w/monitor_h, under
--    the bar too), pinned top-left (move 0,0), but stay a normal floating
--    window so the desktop / your windows stay visible underneath.
--    The Quickshell-avoidance pass below IMMEDIATELY re-sizes each overlay to
--    "monitor minus the quickshell bar strip" so it never covers the shell.
--  - Suppress EVERY event a game can use to force fullscreen/maximize on
--    XWayland ("fullscreen", "maximize", "fullscreenoutput",
--    "x11configurerequest"): exclusive fullscreen forces an opaque surface and
--    kills the see-through, and toggling back restores the game's small
--    geometry. Also keep Hyprland's internal mode out of sync so the client is
--    never told it is fullscreen (sync_fullscreen = false).
--  - Skip Omarchy's default opacity fade so the game's own ARGB alpha is kept.
local function game_overlay_rules()
  return {
    float = true,
    -- Full-monitor baseline (games expect a full screen). The
    -- quickshell-avoidance audit below immediately shrinks+moves it so the
    -- bar stays uncovered, then keeps reconciling it every poll tick.
    size = { "monitor_w", "monitor_h" },
    move = { "0", "0" },
    suppress_event = "maximize fullscreen fullscreenoutput x11configurerequest",
    sync_fullscreen = false,
    no_max_size = true,
    no_shadow = true,
    decorate = false,
    tag = "-default-opacity",
    opacity = "1.0 1.0",
  }
end

-- Widget variant for idle/desktop-pet games (`widget = true` registry
-- entries) that SIZE THEMSELVES by cursor hover. They get float + click-
-- through + fullscreen-suppression, but their geometry is left entirely to
-- the game; the audit never forces monitor-minus-bar on them (it would just
-- fight their expand/collapse).
local function widget_game_overlay_rules()
  return {
    float = true,
    suppress_event = "maximize fullscreen fullscreenoutput",
    sync_fullscreen = false,
    no_max_size = true,
    no_shadow = true,
    decorate = false,
    tag = "-default-opacity",
    opacity = "1.0 1.0",
  }
end

-- A game's Hyprland `class` is the Windows exe name of its main window. While
-- the game is running, find it with:
--   hyprctl clients | grep -iA25 "<game title>"
-- then add the class to the alternation below (pipe-separated, ^...$ anchored).
local OVERLAY_GAME_CLASSES = "^(CQ.*Hero.*Town|Crusaders.*Hero.*Town)$"

o.window(
  { class = OVERLAY_GAME_CLASSES, xwayland = true },
  game_overlay_rules()
)

-- ---------------------------------------------------------------------------
-- OVERLAY GAME REGISTRY (managed by the "overlay-games" control tool)
--
-- Add/remove games here, or use the overlay-games GUI. The compositor's
-- click-through allowlist (/etc/hypr/clickthrough.conf) already matches every
-- `steam_app_.*` class, so Steam/Proton games only need a registry entry.
-- Local (non-Steam) games also need their WM_CLASS in that root-owned
-- allowlist, or clicks won't fall through.
-- >> overlay-games-tool:begin <<
OVERLAY_GAMES = {
  { kind = "steam", class = "steam_app_4126220", name = "Crusaders Quest: Hero Town" },
  -- Idle/desktop-pet games that size themselves by cursor hover: set
  -- widget = true so they float + are click-through but keep their own size.
  -- { kind = "steam", class = "steam_app_2348540", name = "Berserk B.I.T.S", widget = true },
}
-- >> overlay-games-tool:end <<
-- ---------------------------------------------------------------------------

-- Widget games own their geometry (idle games expand/collapse by hover): the
-- audit must not force monitor-minus-bar on them.
local WIDGET_CLASSES = {}
for _, g in ipairs(OVERLAY_GAMES) do
  if g.widget then
    WIDGET_CLASSES[g.class] = true
  end
end

for _, g in ipairs(OVERLAY_GAMES) do
  o.window(
    { class = "^" .. g.class .. "$" },
    g.widget and widget_game_overlay_rules() or game_overlay_rules()
  )
end

-- Crusaders Quest: Hero Town launches two windows:
--   1. "Crusaders Quest : Hero Town"  -> Hyprland class "steam" (the Steam
--      client's own class), so it must be matched by TITLE, not class.
--   2. "CQ Hero Town"                 -> class "steam_app_4126220" (the game's
--      main window; steam_app_<appid> is Steam's per-game class for Proton).
-- hyprland.lua's later `o.window("steam", { float = false })` tiling override
-- would otherwise win on the first window — which is why this module is
-- required AFTER that override (the last rule for a property on a window wins).
o.window(
  { class = "steam", title = "Crusaders Quest.*Hero Town" },
  game_overlay_rules()
)

-- ---------------------------------------------------------------------------
-- Quickshell (Omarchy bar) avoidance
--
-- The overlay is a normal floating XWayland window, so Hyprland never shrinks
-- it for the bar (exclusive-zone reserved areas only apply to tiled layout).
-- We therefore read the quickshell bar's live layer geometry (namespace
-- "omarchy-bar") and resize + offset each overlay window so the bar's strip
-- stays uncovered — top, bottom, left or right.
--
-- This is a self-healing AUDIT, not a one-shot event fix: every overlay
-- window is reconciled against "monitor minus the quickshell strip" on
--   - window.open (plus two quick re-audits, since open can fire before the
--     window is mapped/floating and window.open alone can miss it),
--   - layer open/close for the bar namespace (shell restart, bar appearing/
--     disappearing),
--   - a repeat poll every GEOMETRY_POLL_MS (catches bar drags and anything
--     that re-moved the overlay),
--   - window becoming/leaving fullscreen.
-- Dispatch only happens when the window's geometry strayed from the target, so
-- the poll is a cheap no-op at steady state. Result: the game window can never
-- stay covering the quickshell bar.
-- ---------------------------------------------------------------------------

local BAR_NAMESPACE    = "omarchy-bar"
local GEOMETRY_POLL_MS = 1000
local EPS              = 1

-- Adding a new overlay game — two ways:
--   · quick/managed: add a line to OVERLAY_GAMES in the OVERLAY GAME REGISTRY
--     block above (the generic rules loop and is_overlay_window() pick it up
--     automatically). This is what the overlay-games tool edits.
--   · manual/full control: add BOTH spots by hand —
--       1. an o.window(... game_overlay_rules()) rule near the registry block
--          with the game's class (find it via
--          `hyprctl clients | grep -iA25 "<game title>"`),
--       2. a class check in is_overlay_window() below so the quickshell-
--          avoidance audit tracks it too.
-- The compositor's click-through allowlist (/etc/hypr/clickthrough.conf) is a
-- one-time root setup that already matches every `steam_app_.*` class. See
-- README.md step 7 for the full per-game procedure.

local function is_overlay_window(w)
  local ok, isov = pcall(function()
    if not w then
      return false
    end

    local cls   = w.class or ""
    local title = w.title or ""

    for _, g in ipairs(OVERLAY_GAMES) do
      if cls == g.class then
        return true
      end
    end
    if w.xwayland and cls:match(OVERLAY_GAME_CLASSES) then
      return true
    end
    return cls == "steam" and title:match("Crusaders Quest.*Hero Town") ~= nil
  end)
  return ok and isov
end

local function first_bar(mon)
  for _, ls in ipairs(hl.get_layers({ monitor = mon, namespace = BAR_NAMESPACE })) do
    if ls.mapped then
      return ls
    end
  end
  return nil
end

-- Monitor box minus the bar's strip. Returns the box the overlay should
-- occupy. Falls back to the full monitor when the bar is absent, unmapped, or
-- docked in a way that doesn't span a full edge.
local function subtract_bar(mx, my, mw, mh, bar)
  local x, y, w, h = mx, my, mw, mh
  if not bar then
    return x, y, w, h
  end

  local bx, by, bw, bh = bar.x, bar.y, bar.w, bar.h

  if bw + EPS >= mw then
    -- full-width bar -> top or bottom edge
    if by <= my + EPS and by + bh > my then
      local cut = math.max(0, math.min(by + bh - my, mh))
      y, h = my + cut, mh - cut
    elseif by + bh >= my + mh - EPS and by < my + mh then
      local cut = math.max(0, math.min(my + mh - by, mh))
      h = h - cut
    end
  elseif bh + EPS >= mh then
    -- full-height bar -> left or right edge
    if bx <= mx + EPS and bx + bw > mx then
      local cut = math.max(0, math.min(bx + bw - mx, mw))
      x, w = mx + cut, mw - cut
    elseif bx + bw >= mx + mw - EPS and bx < mx + mw then
      local cut = math.max(0, math.min(mx + mw - bx, mw))
      w = w - cut
    end
  end

  return x, y, w, h
end

-- address -> target box signature last applied, so the audit skips windows
-- that already sit on their budget.
local applied_to = {}

-- Reconcile one overlay window to its bar budget. Returns true if a dispatch
-- was issued. Never throws: every Hyprland-object access is pcall-guarded so a
-- window that died mid-audit is silently skipped, not an error.
local function bar_avoid(win)
  if not is_overlay_window(win) then
    return false
  end

  local okm, mapped   = pcall(function() return win.mapped end)
  local okf, floating = pcall(function() return win.floating end)
  local oks, fullsc   = pcall(function() return win.fullscreen end)
  if not okm or not okf or not oks or not mapped or fullsc ~= 0 then
    -- Not placed yet. The repeat poll will pick it up once it is.
    return false
  end

  -- An overlay game that was already open when this config (re)loaded never
  -- gets its float rule re-applied (rules apply at open time). Force it
  -- floating so the see-through + quickshell-avoidance path actually engages;
  -- sizing happens on the next audit tick.
  if not floating then
    pcall(function()
      hl.dispatch(hl.dsp.window.float({ window = win, action = "set" }))
    end)
    return false
  end

  -- Widget games own their geometry (idle/desktop-pet games that expand by
  -- hover) — forcing monitor-minus-bar on them is exactly what made them
  -- bounce. Keep them floated + click-through, but never resize/move them.
  local okc, cls = pcall(function() return win.class or "" end)
  if okc and WIDGET_CLASSES[cls] then
    return false
  end

  local okmon, mon = pcall(function() return win.monitor end)
  if not okmon or not mon then
    return false
  end

  local okbox, box = pcall(function()
    local bx, by, bw, bh = mon.x, mon.y, mon.width, mon.height
    local x, y, w, h     = subtract_bar(bx, by, bw, bh, first_bar(mon))
    return { x = x, y = y, w = w, h = h }
  end)
  if not okbox or not box then
    return false
  end

  local sig  = string.format("%d@%d@%d@%d", box.x, box.y, box.w, box.h)
  local addr = win.address

  -- Already on budget? Check both the last-applied target and the window's
  -- current goal geometry, so anything that re-strayed the window (game
  -- reshape, missed window.open, ...) gets pulled back on the next tick.
  local okgoal, already = pcall(function()
    local at, sz = win.at, win.size
    return at.x == box.x and at.y == box.y and sz.x == box.w and sz.y == box.h
  end)
  if okgoal and already and applied_to[addr] == sig then
    return false
  end

  local okd = pcall(function()
    hl.dispatch(hl.dsp.window.resize({ x = box.w, y = box.h, window = win }))
    hl.dispatch(hl.dsp.window.move({ x = box.x, y = box.y, window = win }))
  end)
  if okd then
    applied_to[addr] = sig
    return true
  end

  return false
end

local function bar_avoid_all()
  local ok, ws = pcall(hl.get_windows)
  if not (ok and ws) then
    return
  end

  for _, win in ipairs(ws) do
    bar_avoid(win)
  end
end

-- Schedule a short re-audit without piling up timers.
local audit_pending = {}

local function schedule_audit(delayMs)
  if audit_pending[delayMs] then
    return
  end
  audit_pending[delayMs] = true
  hl.timer(function()
    audit_pending[delayMs] = nil
    bar_avoid_all()
  end, { timeout = delayMs, type = "oneshot" })
end

hl.on("window.open", function(win)
  bar_avoid(win)
  -- window.open fires before the window is mapped/floating; the repeat poll
  -- would fix it within a second anyway, but these make a fresh overlay snap
  -- to its bar budget promptly.
  schedule_audit(200)
  schedule_audit(1000)
end)

hl.on("window.fullscreen", function(win)
  if win then
    bar_avoid(win)
  end
end)

hl.on("layer.opened", function(ls)
  if ls and ls.namespace == BAR_NAMESPACE then
    bar_avoid_all()
  end
end)

hl.on("layer.closed", function(ls)
  if ls and ls.namespace == BAR_NAMESPACE then
    bar_avoid_all()
  end
end)

-- Repeat audit: reconciles every overlay window to "monitor minus the bar"
-- regardless of what moved (bar dragged to another edge without the layer
-- closing, window.open missed, game reshaped itself, ...). No-op at steady
-- state thanks to the applied/geometry guards above.
hl.timer(bar_avoid_all, { timeout = GEOMETRY_POLL_MS, type = "repeat" })

-- Catch windows that were already open when this config (re)loaded.
bar_avoid_all()