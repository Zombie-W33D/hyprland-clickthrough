diff --git a/src/xwayland/XShapeInputRegion.hpp b/src/xwayland/XShapeInputRegion.hpp
new file mode 100644
index 0000000..57666b3
--- /dev/null
+++ b/src/xwayland/XShapeInputRegion.hpp
@@ -0,0 +1,15 @@
+#pragma once
+
+#include "../helpers/memory/Memory.hpp"
+
+class CXWaylandSurface;
+
+namespace XShapeInputRegion {
+
+    // Reads the X11 input shape (XShapeInput/XShapeSet) of an XWayland window
+    // and applies it as the wl_surface input region (both current and pending),
+    // so trusted click-through windows get real per-pixel hit-testing.
+    // Must be called on the main thread (safe: Hyprland's xcb connection is
+    // also drained on the main thread).
+    void syncInputRegion(SP<CXWaylandSurface> surf);
+};
