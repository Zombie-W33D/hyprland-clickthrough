@@ -0,0 +1,22 @@
+#pragma once
+
+#include <string>
+
+namespace Desktop::View {
+    class CWindow;
+}
+
+namespace TrustedClickthrough {
+
+    // (Re)reads the root-owned allowlist from /etc/hypr/clickthrough.conf.
+    void load();
+
+    // True if `w` matched an allowlist class rule.
+    bool isTrusted(const Desktop::View::CWindow* w);
+
+    // True if `className` matched an allowlist rule (uses the XWM class/appid).
+    bool isTrustedClass(const std::string& className);
+
+    // Human-readable state for `hyprctl trusted-clickthrough`.
+    std::string status();
+};
