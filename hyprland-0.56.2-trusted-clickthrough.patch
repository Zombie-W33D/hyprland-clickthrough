diff --git a/src/managers/TrustedClickthroughManager.cpp b/src/managers/TrustedClickthroughManager.cpp
new file mode 100644
index 0000000..7fd383a
--- /dev/null
+++ b/src/managers/TrustedClickthroughManager.cpp
@@ -0,0 +1,114 @@
+#include "managers/TrustedClickthroughManager.hpp"
+
+#include "debug/log/Logger.hpp"
+#include "desktop/state/ViewState.hpp"
+#include "desktop/view/Window.hpp"
+#include "event/EventBus.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <format>
+#include <fstream>
+#include <optional>
+#include <regex>
+#include <string>
+#include <vector>
+
+namespace TrustedClickthrough {
+
+    constexpr const char* CONFIG_PATH = "/etc/hypr/clickthrough.conf";
+
+    struct SState {
+        std::vector<std::regex> classRules;
+    };
+
+    SState& state() {
+        static SState s;
+        return s;
+    }
+
+    // Registered once (on the first `load`); re-reads the allowlist on config
+    // reloads and on compositor start, so
+    //   sudoedit /etc/hypr/clickthrough.conf && hyprctl reload
+    // applies without a restart.
+    void ensureReloadListener() {
+        static bool REGISTERED = false;
+        if (REGISTERED)
+            return;
+        REGISTERED = true;
+        static auto CONFIG_RELOAD = Event::bus()->m_events.config.reloaded.listen([] { load(); });
+        static auto START         = Event::bus()->m_events.start.listen([] { load(); });
+    }
+
+    void load() {
+        ensureReloadListener();
+
+        auto&       RULES = state().classRules;
+        RULES.clear();
+
+        std::ifstream ifs(CONFIG_PATH);
+        if (!ifs.good()) {
+            Log::logger->log(Log::DEBUG, "TrustedClickthrough: no allowlist at {}, nothing is click-through", CONFIG_PATH);
+            return;
+        }
+
+        std::string line;
+        while (std::getline(ifs, line)) {
+            line.erase(line.begin(), std::find_if(line.begin(), line.end(), [](unsigned char c) { return !std::isspace(c); }));
+            line.erase(std::find_if(line.rbegin(), line.rend(), [](unsigned char c) { return !std::isspace(c); }).base(), line.end());
+
+            if (line.empty() || line.starts_with('#'))
+                continue;
+
+            try {
+                RULES.emplace_back(line, std::regex::ECMAScript | std::regex::icase);
+                Log::logger->log(Log::DEBUG, "TrustedClickthrough: allowed class {}" , line);
+            } catch (const std::regex_error& e) {
+                Log::logger->log(Log::ERR, "TrustedClickthrough: bad class regex '{}': {}", line, e.what());
+            }
+        }
+
+        Log::logger->log(Log::DEBUG, "TrustedClickthrough: {} class rule(s) from {}", RULES.size(), CONFIG_PATH);
+    }
+
+    bool isTrusted(const Desktop::View::CWindow* w) {
+        if (!w)
+            return false;
+
+        return isTrustedClass(w->m_class);
+    }
+
+    bool isTrustedClass(const std::string& className) {
+        if (className.empty())
+            return false;
+
+        const auto& RULES = state().classRules;
+        if (RULES.empty())
+            return false;
+
+        for (const auto& rule : RULES) {
+            if (std::regex_search(className, rule))
+                return true;
+        }
+
+        return false;
+    }
+
+    std::string status() {
+        std::string out;
+
+        const auto& RULES = state().classRules;
+        if (RULES.empty()) {
+            out = "trusted click-through: DISABLED (no rules in " + std::string(CONFIG_PATH) + ")\n";
+        } else {
+            out = "trusted click-through rules (" + std::to_string(RULES.size()) + "):\n";
+            for (const auto& w : Desktop::viewState()->windows()) {
+                if (isTrusted(w.get()))
+                    out += "  matched: " + w->m_class + " [" + std::format("{:012x}", (uintptr_t)w.get()) + "]\n";
+            }
+            out += "source: " + std::string(CONFIG_PATH);
+        }
+
+        return out;
+    }
+};
