diff --git a/src/xwayland/XShapeInputRegion.cpp b/src/xwayland/XShapeInputRegion.cpp
new file mode 100644
index 0000000..0e6224d
--- /dev/null
+++ b/src/xwayland/XShapeInputRegion.cpp
@@ -0,0 +1,86 @@
+#include "XShapeInputRegion.hpp"
+
+#include "XSurface.hpp"
+#include "XWayland.hpp"
+#include "../debug/log/Logger.hpp"
+#include "../managers/TrustedClickthroughManager.hpp"
+#include "../protocols/core/Compositor.hpp"
+
+#ifndef NO_XWAYLAND
+#include <xcb/shape.h>
+#endif
+
+#include <optional>
+
+namespace XShapeInputRegion {
+
+#ifndef NO_XWAYLAND
+    // The XShape extension never changes at runtime; cache the result.
+    struct SShapeExtInfo {
+        bool      present = false;
+        uint32_t  eventBase = 0;
+    };
+
+    const SShapeExtInfo* shapeExtension() {
+        static std::optional<SShapeExtInfo> CACHED;
+        if (!CACHED.has_value()) {
+            CACHED = SShapeExtInfo{};
+            auto* conn = g_pXWayland && g_pXWayland->m_wm ? g_pXWayland->m_wm->getConnection() : nullptr;
+            if (!conn)
+                return &*CACHED;
+
+            const auto* ext = xcb_get_extension_data(conn, &xcb_shape_id);
+            if (ext) {
+                CACHED.value().present    = ext->present;
+                CACHED.value().eventBase = ext->first_event;
+            }
+        }
+        return &*CACHED;
+    }
+#endif
+
+    void syncInputRegion(SP<CXWaylandSurface> surf) {
+        if (!surf || !surf->m_surface)
+            return;
+
+        // Only apply to allowlisted classes; the hit-tester is what decides
+        // whether the region is honoured or not.
+        if (!TrustedClickthrough::isTrustedClass(surf->m_state.appid))
+            return;
+
+#ifndef NO_XWAYLAND
+        const auto* EXT = shapeExtension();
+        if (!EXT || !EXT->present)
+            return;
+
+        auto* conn = g_pXWayland && g_pXWayland->m_wm ? g_pXWayland->m_wm->getConnection() : nullptr;
+        if (!conn)
+            return;
+
+        const auto COOKIE = xcb_shape_get_rectangles(conn, surf->m_xID, XCB_SHAPE_SK_INPUT, XCB_SHAPE_SO_SET);
+        std::unique_ptr<xcb_shape_get_rectangles_reply_t, decltype(&free)> reply(xcb_shape_get_rectangles_reply(conn, COOKIE, nullptr), &free);
+        if (!reply)
+            return;
+
+        Hyprutils::Math::CRegion region;
+        for (int i = 0; i < reply->number_rectangles; i++) {
+            const auto& rect = reply->rectangles[i];
+            region.add(rect.x, rect.y, rect.width, rect.height);
+        }
+
+        // Region is empty when the window has no shape/fully transparent input;
+        // leave the surface alone then (an empty region would mean *everything*
+        // is click-through, same as full box to the compositor).
+        if (region.empty())
+            return;
+
+        const auto SURF = surf->m_surface;
+        SURF->m_pending.input           = region.copy();
+        SURF->m_pending.inputIsInfinite = false;
+        SURF->m_current.input           = region.copy();
+        SURF->m_current.inputIsInfinite = false;
+#else
+        (void)surf;
+#endif
+    }
+};
