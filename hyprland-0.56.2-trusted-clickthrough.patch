+static std::string dispatchTrustedClickthrough(eHyprCtlOutputFormat format, std::string request) {
+    CVarList vars(request, 0, ' ');
+
+    for (const auto& arg : vars | std::views::drop(1)) {
+        if (arg == "reload") {
+            TrustedClickthrough::load();
+            return "ok";
+        }
+    }
+
+    return TrustedClickthrough::status();
+}
