+    // For an allowlisted (root-trusted) window, honour its wl_surface input
+    // region like we already do for layer surfaces: a pointer position outside
+    // that region falls through to the windows below, exactly like Omagotchi's
+    // `mask`. Only meaningful on floating windows; fully trusted windows keep
+    // their own input region from XWayland (XShape) / set_input_region.
+    const auto isClickThroughAt = [](PHLWINDOW w, const Vector2D& pos) -> bool {
+        if (!TrustedClickthrough::isTrusted(w.get()))
+            return false;
+
+        const auto SURF = w->wlSurface() ? w->wlSurface()->resource() : nullptr;
+        if (!SURF || SURF->m_current.inputIsInfinite)
+            return false;
+
+        const auto ORIGIN = w->position(Desktop::View::IGeometric::GEOMETRIC_GOAL);
+        const auto REGION = SURF->m_current.effectiveInputRegion().translate(ORIGIN);
+        return !REGION.containsPoint(pos);
+    };
