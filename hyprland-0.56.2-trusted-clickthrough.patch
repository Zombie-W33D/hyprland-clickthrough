+bool CXWM::handleShapeNotify(xcb_shape_notify_event_t* e) {
+    // Only the input shape drives click-through; ignore bounding/clip changes.
+    if (e->shape_kind != XCB_SHAPE_SK_INPUT)
+        return true;
+
+    const auto SURF = windowForXID(e->affected_window);
+    if (!SURF)
+        return true;
+
+    // Event-driven refresh: Wine/GE reshape the input shape with no repaint
+    // (overlay hide, media toggles), which never fires a wl_surface commit.
+    // This keeps the input region current the moment the shape changes,
+    // instead of on the next commit (or an alt-tab restack).
+    XShapeInputRegion::syncInputRegion(SURF);
+
+    return true;
+}
