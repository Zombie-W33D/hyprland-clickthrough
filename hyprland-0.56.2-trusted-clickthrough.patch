diff --git c/src/xwayland/XShapeInputRegion.cpp w/src/xwayland/XShapeInputRegion.cpp
new file mode 100644
index 0000000..d93e706
--- /dev/null
+++ w/src/xwayland/XShapeInputRegion.cpp
@@ -0,0 +1,81 @@
+#include "XShapeInputRegion.hpp"
+
+#include "XSurface.hpp"
+#include "XWayland.hpp"
+#include "../debug/log/Logger.hpp"
+#include "../managers/TrustedClickthroughManager.hpp"
+#include "../protocols/core/Compositor.hpp"
+
+#ifndef NO_XWAYLAND
+#include <xcb/shape.h>
+
+#include <memory>
+#endif
+
+namespace XShapeInputRegion {
+
+    void syncInputRegion(SP<CXWaylandSurface> surf) {
+        if (!surf || !surf->m_surface)
+            return;
+
+        // Only apply to allowlisted classes; the hit-tester is what decides
+        // whether the region is honoured or not.
+        if (!TrustedClickthrough::isTrustedClass(surf->m_state.appid))
+            return;
+
+#ifndef NO_XWAYLAND
+        auto* conn = surf->getXCBConnection();
+        if (!conn)
+            return;
+
+        // Constant after connect (in-memory index), cheap to call.
+        const auto* shapeExt = xcb_get_extension_data(conn, &xcb_shape_id);
+        if (!shapeExt || !shapeExt->present)
+            return;
+
+        // Subscribe to XShape input-shape change events so we can re-sync
+        // without waiting for a wl_surface commit. Wine/GE reshapes the input
+        // shape with no repaint (overlay hide, media toggles) and those changes
+        // never commit; the XWM's ShapeNotify handler drains them here.
+        // One-time, idempotent; enable = bitmask, Input kind is bit 2.
+        if (!surf->m_inputShapeNotifySubscribed) {
+            xcb_shape_select_input(conn, surf->m_xID, 1 << XCB_SHAPE_SK_INPUT);
+            xcb_flush(conn);
+            surf->m_inputShapeNotifySubscribed = true;
+        }
+
+        const auto COOKIE = xcb_shape_get_rectangles(conn, surf->m_xID, XCB_SHAPE_SK_INPUT);
+        std::unique_ptr<xcb_shape_get_rectangles_reply_t, decltype(&free)> reply(xcb_shape_get_rectangles_reply(conn, COOKIE, nullptr), &free);
+        if (!reply)
+            return;
+
+        const int RECT_LEN = xcb_shape_get_rectangles_rectangles_length(reply.get());
+
+        Hyprutils::Math::CRegion region;
+        const auto*              RECTS = xcb_shape_get_rectangles_rectangles(reply.get());
+        for (int i = 0; i < RECT_LEN; i++)
+            region.add(RECTS[i].x, RECTS[i].y, RECTS[i].width, RECTS[i].height);
+
+        auto SURF = surf->m_surface;
+
+        // Empty/absent shape = the window has NO input shape, so the whole
+        // surface is its input region (X semantics). Reset to the compositor
+        // default instead of keeping the stale region — that early return was
+        // exactly the "overlay hidden but click-through stuck" bug.
+        if (RECT_LEN <= 0 || region.empty()) {
+            SURF->m_pending.input.clear();
+            SURF->m_pending.inputIsInfinite = true;
+            SURF->m_current.input.clear();
+            SURF->m_current.inputIsInfinite = true;
+            return;
+        }
+
+        SURF->m_pending.input           = region.copy();
+        SURF->m_pending.inputIsInfinite = false;
+        SURF->m_current.input           = region.copy();
+        SURF->m_current.inputIsInfinite = false;
+#else
+        (void)surf;
+#endif
+    }
+};
